# Meta Business Suite credentials
# Get your access token from https://developers.facebook.com/
META_ACCESS_TOKEN=your_meta_access_token

# Your Meta Business ID
META_BUSINESS_ID=your_meta_business_id

# Optional: secret for POST /api/revalidate (header x-revalidate-secret)
REVALIDATE_SECRET=

# Optional branding (defaults: WhatsApp green, no company logo)
# BRAND_NAME=Acme
# BRAND_LOGO_URL=https://example.com/logo.svg   # https URL or a path under /public, e.g. /logo.png
# BRAND_COLOR=#25D366
# BRAND_LOGO_BACKGROUND=white                   # only for dark logos that vanish on the dark bar

# Optional: public address, for the link-preview image (defaults to AUTH_URL's origin or the Vercel domain)
# SITE_URL=https://plantillas.example.com

# Optional: Microsoft Entra ID login. Login turns on when these are set (all of them).
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_SECRET=                                  # generate with: npx auth secret
# AUTH_ALLOWED_EMAILS=ana@empresa.com,luis@empresa.com   # optional allowlist

# Optional: send analytics from Salesforce's WhatsApp events. Shown only with login on (or in `npm run dev`).
# Source 1 (preferred): a copy of the events table in Amazon Athena.
# ATHENA_REGION=eu-west-1
# ATHENA_TABLE=<database>.<table>
# ATHENA_WORKGROUP=primary                      # default
# ATHENA_OUTPUT_LOCATION=s3://<bucket>/<prefix>/  # only if the workgroup has none
# ATHENA_ACCESS_KEY_ID=                         # technical IAM user, required on Vercel; locally use AWS_PROFILE with SSO
# ATHENA_SECRET_ACCESS_KEY=
# Source 2 (fallback, used when Athena is not set): Salesforce Data Cloud.
# SF_INSTANCE_URL=https://<org>.my.salesforce.com
# SF_CLIENT_ID=                                 # External Client App, client credentials flow
# SF_CLIENT_SECRET=
# SF_ACCESS_TOKEN=                              # local dev only, instead of SF_CLIENT_ID/SECRET
# DATACLOUD_WHATSAPP_DLO=MessagingEventsWhatsAppV2_<suffix>__dll  # required: the events object, named differently in each org
# ANALYTICS_WITHOUT_LOGIN=true                  # Vercel previews only (ignored in production); use with Deployment Protection
